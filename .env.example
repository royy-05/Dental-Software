# Copy to .env (never commit .env). Values below are local-development placeholders only.

# Runtime connection: the kivi_app role (row-level security applies).
DATABASE_URL="postgresql://kivi_app:kivi_app_local_only@localhost:5432/kivi"
# Owner connection: migrations, seed, pg-boss maintenance. Never used for request handling.
DIRECT_DATABASE_URL="postgresql://kivi:kivi_local_only@localhost:5432/kivi"

# Test database (vitest integration tests and Playwright). Same roles, separate database.
TEST_DATABASE_URL="postgresql://kivi_app:kivi_app_local_only@localhost:5432/kivi_test"
TEST_DIRECT_DATABASE_URL="postgresql://kivi:kivi_local_only@localhost:5432/kivi_test"

# Auth.js secret (openssl rand -base64 32)
AUTH_SECRET=""
# Trust the host header in dev / behind a proxy you control.
AUTH_TRUST_HOST="true"
# 32-byte key, base64 (openssl rand -base64 32). Encrypts TOTP secrets at rest.
APP_ENCRYPTION_KEY=""
# HMAC key for patient confirm / reschedule / cancel links (openssl rand -base64 32)
LINK_SIGNING_SECRET=""

# Public base URL used in emails and SMS links
APP_BASE_URL="http://localhost:3000"

# Email: "resend" (needs RESEND_API_KEY) or "console" (dev: logs message id only, never content)
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Kivi Health <bookings@example.com>"

# SMS: "mock" | "twilio" (stub) | "msg91" (stub)
SMS_DRIVER="mock"
# Shared secret the SMS provider sends on inbound webhooks (header x-webhook-secret)
SMS_WEBHOOK_SECRET=""

# Shows the demo account list on /login. Never enable in production.
DEMO_MODE="true"
# Password given to every seeded demo account (development only).
SEED_DEMO_PASSWORD="Demo-Passw0rd-2026"
